# ==============================================================================
# Environment Configuration - Data Ingestion & Analytics Platform
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME="Chronicle"
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration
# PostgreSQL URI format: postgresql+psycopg://user:password@host:port/dbname
# SQLite format (for local testing without Postgres): sqlite:///./data/analytics.db
DATABASE_URL=sqlite:///./data/analytics.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT Security
SECRET_KEY=super-secret-jwt-key-change-in-production-min-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User Setup (created on first run if not exists)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
INITIAL_ADMIN_NAME="System Administrator"

# Ingestion & Storage Settings
UPLOAD_DIR=./storage/uploads
QUARANTINE_DIR=./storage/quarantine
MAX_UPLOAD_SIZE_MB=50

# Exchange Rates relative to USD (Configurable Currency Conversion)
CURRENCY_RATES_JSON='{"USD": 1.0, "EUR": 1.08, "GBP": 1.28, "CAD": 0.73, "INR": 0.012, "AUD": 0.66}'

# AWS Cloud Settings (optional, for S3 deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
USE_S3_STORAGE=false
